# Web search: at least one (tavily,serper,brave are tried in that order; override with SEARCH_PROVIDER_ORDER)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Extraction LLM: any OpenAI-compatible endpoint (defaults: LM Studio on localhost)
QUALK_LLM_URL=http://localhost:1234/v1
QUALK_LLM_KEY=lm-studio
QUALK_LLM_MODEL=gpt-oss-20b

# Optional: run the walk circuit on Moth Atlas (otherwise local Qiskit). Default: emulator provider 'aer'.
MOTH_API_KEY=
# Atlas emulator target (backend "atlas" in the app / --quantum_backend atlas). All optional.
MOTH_ATLAS_PROVIDER=aer
MOTH_ATLAS_BACKEND=automatic
MOTH_ATLAS_TIMEOUT=90
# 1 = a failed Atlas job stops the run instead of falling back to local Qiskit
MOTH_ATLAS_STRICT=
# Real QPU target (backend "qpu"; needs the account feature run_quantum). The tomography engine has no mode
# switch, so the hardware is chosen by provider + backend names as given by Moth for your account.
# A QPU run never falls back to a simulator: a failed job stops the run.
MOTH_QPU_PROVIDER=
MOTH_QPU_BACKEND=
MOTH_QPU_TIMEOUT=900

# Web app (python app.py): optional access token. Leave empty for no login.
QUALK_TOKEN=
