# Web search: at least one (tavily,serper,brave are tried in that order; override with SEARCH_PROVIDER_ORDER)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Extraction LLM: any OpenAI-compatible endpoint (defaults: LM Studio on localhost)
QUALK_LLM_URL=http://localhost:1234/v1
QUALK_LLM_KEY=lm-studio
QUALK_LLM_MODEL=gpt-oss-20b

# Optional: run the walk circuit on Moth Atlas (otherwise local Qiskit). Emulator provider 'aer'.
MOTH_API_KEY=

# Web app (python app.py): optional access token. Leave empty for no login.
QUALK_TOKEN=
